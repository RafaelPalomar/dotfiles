#!/usr/bin/env python3
"""Non-LLM fallback for the pks-daily-review skill.

Produces a structural digest of the PKS state and writes it as a
denote-named org file under ~/pks/fleeting/.  Four sections:

  1. Stale fleeting notes (denote date >14 days old)
  2. Active project notes (tagged _agenda)
  3. Stale MOCs (mtime >30 days)
  4. Stale review-queue items (mtime >30 days, recurses into
     personal/ and work/ subdirectories)

Each section groups items by scope (work / personal / general) based
on whether the note's path contains a /work/ or /personal/ segment.
General is the legacy untagged top level of each silo.

Use --scope to filter to one scope.  Default is 'all' (show every
scope, sectioned).  Idempotent per day: re-running overwrites.
"""
import argparse
import datetime
import json
import os
import subprocess
import sys

PKS = os.path.expanduser("~/pks")
TODAY = datetime.date.today()
NOW = datetime.datetime.now()
DAILY_ID = TODAY.strftime("%Y%m%dT080000")
OUT = os.path.join(PKS, "fleeting",
                   f"{DAILY_ID}--daily-review__review.org")

SCOPES = ("work", "personal", "general")


def scope_of(path):
    parts = os.path.normpath(path).split(os.sep)
    if "personal" in parts:
        return "personal"
    if "work" in parts:
        return "work"
    return "general"


def denotecli(*args):
    try:
        out = subprocess.check_output(
            ["denotecli", *args, "--max", "300"], text=True)
        return json.loads(out) if out.strip() else []
    except (subprocess.CalledProcessError, json.JSONDecodeError) as e:
        print(f"warn: denotecli {' '.join(args)} failed: {e}",
              file=sys.stderr)
        return []


def days_since_denote(date_str):
    return (TODAY - datetime.date.fromisoformat(date_str)).days


def days_since_mtime(path):
    try:
        return int((NOW.timestamp() - os.path.getmtime(path)) / 86400)
    except OSError:
        return None


def fmt_link(n):
    tags = " ".join(f"_{t}" for t in (n.get("tags") or []))
    return f"[[denote:{n['id']}][{n['title']}]]  {tags}".rstrip()


def group_by_scope(items, sort_keys, want_scope):
    groups = {s: [] for s in SCOPES}
    for entry in items:
        n = entry[0] if isinstance(entry, tuple) else entry
        s = scope_of(n["path"])
        if want_scope != "all" and s != want_scope:
            continue
        groups[s].append(entry)
    return groups


def render_section(header_label, items, age_fmt, want_scope):
    """Render a section.  ITEMS is a list of (note, age) tuples or
    bare note dicts.  AGE_FMT(item) returns the leading age column."""
    groups = group_by_scope(items, None, want_scope)
    counts = {s: len(groups[s]) for s in SCOPES}
    total = sum(counts.values())

    if want_scope == "all":
        breakdown = " / ".join(f"{s}: {counts[s]}" for s in SCOPES)
    else:
        breakdown = f"{want_scope}: {counts[want_scope]}"

    out = ["", f"* {header_label}  — {breakdown} / total: {total}"]
    if total == 0:
        out.append("- None")
        return out

    for s in SCOPES:
        if not groups[s]:
            continue
        if want_scope == "all":
            out.append(f"** {s}")
        for entry in groups[s]:
            out.append(f"- {age_fmt(entry)}{fmt_link(entry[0] if isinstance(entry, tuple) else entry)}")
    return out


def main():
    p = argparse.ArgumentParser()
    p.add_argument("--scope", choices=("all", "work", "personal", "general"),
                   default="all",
                   help="restrict output to one scope (default: all)")
    args = p.parse_args()
    scope = args.scope

    # Section 1: stale fleeting
    fleeting = denotecli("search", "", "--dirs",
                         os.path.join(PKS, "fleeting"))
    stale_fleeting = sorted(
        (n for n in fleeting if days_since_denote(n["date"]) > 14),
        key=lambda n: n["date"])

    # Section 2: active projects (_agenda)
    projects = denotecli("search", "", "--dirs",
                         os.path.join(PKS, "projects"), "--tags", "agenda")

    # Section 3: stale MOCs (mtime >30d)
    mocs = denotecli("search", "", "--dirs",
                     os.path.join(PKS, "reference"), "--tags", "moc")
    stale_mocs = []
    for n in mocs:
        age = days_since_mtime(n["path"])
        if age is not None and age > 30:
            stale_mocs.append((n, age))
    stale_mocs.sort(key=lambda x: x[1], reverse=True)

    # Section 4: stale review-queue (mtime >30d)
    review_queue = denotecli("search", "", "--dirs",
                             os.path.join(PKS, "review-queue"))
    stale_review = []
    for n in review_queue:
        age = days_since_mtime(n["path"])
        if age is not None and age > 30:
            stale_review.append((n, age))
    stale_review.sort(key=lambda x: x[1], reverse=True)

    lines = [
        f"#+title:      Daily review {TODAY.isoformat()}",
        f"#+date:       [{TODAY.isoformat()}]",
        f"#+filetags:   :review:",
        f"#+identifier: {DAILY_ID}",
        "",
        "Generated by pks-daily-review (non-LLM fallback). Same-day re-run",
        "overwrites this note. Items grouped by scope (work / personal /",
        "general); scope-aware filtering via --scope.",
        "",
        f"Scope filter: {scope}",
    ]

    lines += render_section(
        "Stale fleeting (>14d)",
        [(n, days_since_denote(n["date"])) for n in stale_fleeting],
        lambda e: f"{e[1]:>3}d  ",
        scope)

    lines += render_section(
        "Active projects (_agenda)",
        list(projects),
        lambda e: "     ",
        scope)

    lines += render_section(
        "Stale MOCs (>30d mtime)",
        stale_mocs,
        lambda e: f"{e[1]:>3}d  ",
        scope)

    lines += render_section(
        "Stale review-queue (>30d mtime)",
        stale_review,
        lambda e: f"{e[1]:>3}d  ",
        scope)

    lines.append("")

    os.makedirs(os.path.dirname(OUT), exist_ok=True)
    with open(OUT, "w") as f:
        f.write("\n".join(lines))

    print(OUT)


if __name__ == "__main__":
    main()
