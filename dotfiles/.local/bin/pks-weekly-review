#!/usr/bin/env python3
"""Non-LLM fallback for the pks-weekly-review skill.

Sunday-cadence digest of project-level staleness that the daily
review doesn't catch:

  1. Stale projects (file mtime >14 days) — Status is probably out
     of date.
  2. Stale _agenda notes (any silo, mtime >14 days) — agenda items
     that haven't moved.  The daily review lists current _agenda
     projects without filtering by staleness; this filter catches
     ones that are sitting.
  3. Stale review-queue items (mtime >30 days) — same as daily;
     repeated here so the weekly digest is self-contained.

Each section groups items by scope (work / personal / general) based
on whether the path contains a /work/ or /personal/ segment.  Use
--scope to filter to one scope.

Idempotent per Sunday: re-running on the same day overwrites.
"""
import argparse
import datetime
import json
import os
import subprocess
import sys

PKS = os.path.expanduser("~/pks")
TODAY = datetime.date.today()
NOW = datetime.datetime.now()
ISO_WEEK = TODAY.strftime("%G-W%V")
WEEKLY_ID = TODAY.strftime("%Y%m%dT190000")
OUT = os.path.join(
    PKS, "fleeting",
    f"{WEEKLY_ID}--weekly-review-{ISO_WEEK}__review.org")

SCOPES = ("work", "personal", "general")


def scope_of(path):
    parts = os.path.normpath(path).split(os.sep)
    if "personal" in parts:
        return "personal"
    if "work" in parts:
        return "work"
    return "general"


def denotecli(*args):
    try:
        out = subprocess.check_output(
            ["denotecli", *args, "--max", "300"], text=True)
        return json.loads(out) if out.strip() else []
    except (subprocess.CalledProcessError, json.JSONDecodeError) as e:
        print(f"warn: denotecli {' '.join(args)} failed: {e}",
              file=sys.stderr)
        return []


def days_since_mtime(path):
    try:
        return int((NOW.timestamp() - os.path.getmtime(path)) / 86400)
    except OSError:
        return None


def stale_filter(notes, threshold_days):
    out = []
    for n in notes:
        age = days_since_mtime(n["path"])
        if age is not None and age > threshold_days:
            out.append((n, age))
    out.sort(key=lambda x: x[1], reverse=True)
    return out


def fmt_link(n):
    tags = " ".join(f"_{t}" for t in (n.get("tags") or []))
    return f"[[denote:{n['id']}][{n['title']}]]  {tags}".rstrip()


def render_section(header_label, items, age_fmt, want_scope):
    groups = {s: [] for s in SCOPES}
    for entry in items:
        n = entry[0] if isinstance(entry, tuple) else entry
        s = scope_of(n["path"])
        if want_scope != "all" and s != want_scope:
            continue
        groups[s].append(entry)
    counts = {s: len(groups[s]) for s in SCOPES}
    total = sum(counts.values())

    if want_scope == "all":
        breakdown = " / ".join(f"{s}: {counts[s]}" for s in SCOPES)
    else:
        breakdown = f"{want_scope}: {counts[want_scope]}"

    out = ["", f"* {header_label}  — {breakdown} / total: {total}"]
    if total == 0:
        out.append("- None")
        return out
    for s in SCOPES:
        if not groups[s]:
            continue
        if want_scope == "all":
            out.append(f"** {s}")
        for entry in groups[s]:
            n = entry[0] if isinstance(entry, tuple) else entry
            out.append(f"- {age_fmt(entry)}{fmt_link(n)}")
    return out


def main():
    p = argparse.ArgumentParser()
    p.add_argument("--scope", choices=("all", "work", "personal", "general"),
                   default="all",
                   help="restrict output to one scope (default: all)")
    args = p.parse_args()
    scope = args.scope

    projects = denotecli("search", "", "--dirs",
                         os.path.join(PKS, "projects"), "--tags", "project")
    stale_projects = stale_filter(projects, 14)

    agenda_notes = denotecli("search", "", "--dirs", PKS, "--tags", "agenda")
    stale_agenda = stale_filter(agenda_notes, 14)

    review_queue = denotecli("search", "", "--dirs",
                             os.path.join(PKS, "review-queue"))
    stale_review = stale_filter(review_queue, 30)

    lines = [
        f"#+title:      Weekly review {ISO_WEEK}",
        f"#+date:       [{TODAY.isoformat()}]",
        f"#+filetags:   :review:",
        f"#+identifier: {WEEKLY_ID}",
        "",
        "Generated by pks-weekly-review (non-LLM fallback). Items grouped",
        "by scope (work / personal / general); filter via --scope.",
        "",
        f"Scope filter: {scope}",
    ]

    lines += render_section(
        "Stale projects (>14d mtime)",
        stale_projects,
        lambda e: f"{e[1]:>3}d  ",
        scope)

    lines += render_section(
        "Stale _agenda notes (any silo, >14d mtime)",
        stale_agenda,
        lambda e: f"{e[1]:>3}d  ",
        scope)

    lines += render_section(
        "Stale review-queue (>30d mtime)",
        stale_review,
        lambda e: f"{e[1]:>3}d  ",
        scope)

    lines.append("")

    os.makedirs(os.path.dirname(OUT), exist_ok=True)
    with open(OUT, "w") as f:
        f.write("\n".join(lines))

    print(OUT)


if __name__ == "__main__":
    main()
