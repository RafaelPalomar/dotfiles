# SSH config — managed by dotfiles (entelequia/home-dotfiles-service-type)
#
# Per-host key pinning (ADR-0003; docs/source/secrets.rst). The GnuPG
# agent holds many [A] subkeys; without pinning, ssh offers ALL of them
# and trips a hardened server's MaxAuthTries (3 on entelequia sshd),
# failing with "Too many authentication failures". Each block below pins
# exactly ONE public key via `IdentityFile` + `IdentitiesOnly yes`, so the
# server sees a single attempt regardless of how many keys the agent holds.
#
# Public deploy keys live in ~/.keys/ssh/deploy/<name>.pub (emitted by
# `keys deploy pubkey`); the primary [SA] auth key in
# ~/.keys/ssh/primary-auth.pub. `keys audit` checks each deploy key has a
# matching .pub.

# Domain-specific hosts whose internal addresses must NOT be committed to
# this personal repo (e.g. IVS / OUS hosts on 10.x) are pinned in their own
# files under ~/.ssh/config.d/ — see config.d/README.md for the template.
Include ~/.ssh/config.d/*.conf

# Work tailnet hosts — routed via the userspace tailscale-work SOCKS5 proxy.
# The proxy is started automatically by the tailscale-work shepherd service.
# One-time login if needed: tailscale-work up --accept-dns=false
Host *.tail21396.ts.net ivs-aud-mac-mini
    ProxyCommand ncat --proxy 127.0.0.1:1055 --proxy-type socks5 %h %p
    User rafael

# ── Operator workstations + forges: pinned to the primary [SA] auth subkey ──
Host einstein einstein.local curie curie.local
    User rafael
    Port 2222
    IdentityAgent SSH_AUTH_SOCK
    IdentityFile ~/.keys/ssh/primary-auth.pub
    IdentitiesOnly yes

Host github.com gitlab.com
    User git
    IdentityAgent SSH_AUTH_SOCK
    IdentityFile ~/.keys/ssh/primary-auth.pub
    IdentitiesOnly yes
    PreferredAuthentications publickey

# ── entelequia deploy hosts: each pinned to its own deploy [A] subkey ──
# HostName/User/Port mirror entelequia/deploy/<host>.scm (source of truth).
Host edison
    HostName 192.168.88.14
    User root
    Port 2222
    IdentityAgent SSH_AUTH_SOCK
    IdentityFile ~/.keys/ssh/deploy/edison.pub
    IdentitiesOnly yes

Host hopper
    HostName 192.168.88.245
    User root
    Port 2222
    IdentityAgent SSH_AUTH_SOCK
    IdentityFile ~/.keys/ssh/deploy/hopper.pub
    IdentitiesOnly yes

Host lovelace
    HostName 192.168.88.46
    User root
    Port 2222
    IdentityAgent SSH_AUTH_SOCK
    IdentityFile ~/.keys/ssh/deploy/lovelace.pub
    IdentitiesOnly yes
