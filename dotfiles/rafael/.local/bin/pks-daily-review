#!/usr/bin/env python3
"""Non-LLM fallback for the pks-daily-review skill.

Produces a structural digest of the PKS state and writes it as a
denote-named org file under ~/pks/fleeting/.  Four sections:

  1. Stale fleeting notes (denote date >14 days old)
  2. Active project notes (tagged _agenda)
  3. Stale MOCs (mtime >30 days)
  4. Stale review-queue items (mtime >30 days)

Idempotent per day: re-running overwrites.
"""
import datetime
import json
import os
import subprocess
import sys

PKS = os.path.expanduser("~/pks")
TODAY = datetime.date.today()
NOW = datetime.datetime.now()
DAILY_ID = TODAY.strftime("%Y%m%dT080000")
OUT = os.path.join(PKS, "fleeting",
                   f"{DAILY_ID}--daily-review__review.org")


def denotecli(*args):
    try:
        out = subprocess.check_output(
            ["denotecli", *args, "--max", "300"], text=True)
        if not out.strip():
            return []
        result = json.loads(out)
        return result if isinstance(result, list) else []
    except (subprocess.CalledProcessError, json.JSONDecodeError) as e:
        print(f"warn: denotecli {' '.join(args)} failed: {e}",
              file=sys.stderr)
        return []


def days_since_denote(date_str):
    return (TODAY - datetime.date.fromisoformat(date_str)).days


def days_since_mtime(path):
    try:
        return int((NOW.timestamp() - os.path.getmtime(path)) / 86400)
    except OSError:
        return None


def fmt_link(n):
    tags = " ".join(f"_{t}" for t in (n.get("tags") or []))
    return f"[[denote:{n['id']}][{n['title']}]]  {tags}".rstrip()


def render_section(header_label, items, age_fmt):
    """ITEMS is a list of (note, age) tuples or bare note dicts.
    AGE_FMT(item) returns the leading age column."""
    total = len(items)
    out = ["", f"* {header_label}  — total: {total}"]
    if total == 0:
        out.append("- None")
        return out
    for entry in items:
        n = entry[0] if isinstance(entry, tuple) else entry
        out.append(f"- {age_fmt(entry)}{fmt_link(n)}")
    return out


def main():
    # Section 1: stale fleeting
    fleeting = denotecli("search", "", "--dirs",
                         os.path.join(PKS, "fleeting"))
    stale_fleeting = sorted(
        (n for n in fleeting if days_since_denote(n["date"]) > 14),
        key=lambda n: n["date"])

    # Section 2: active projects (_agenda)
    projects = denotecli("search", "", "--dirs",
                         os.path.join(PKS, "projects"), "--tags", "agenda")

    # Section 3: stale MOCs (mtime >30d)
    mocs = denotecli("search", "", "--dirs",
                     os.path.join(PKS, "reference"), "--tags", "moc")
    stale_mocs = []
    for n in mocs:
        age = days_since_mtime(n["path"])
        if age is not None and age > 30:
            stale_mocs.append((n, age))
    stale_mocs.sort(key=lambda x: x[1], reverse=True)

    # Section 4: stale review-queue (mtime >30d)
    review_queue = denotecli("search", "", "--dirs",
                             os.path.join(PKS, "review-queue"))
    stale_review = []
    for n in review_queue:
        age = days_since_mtime(n["path"])
        if age is not None and age > 30:
            stale_review.append((n, age))
    stale_review.sort(key=lambda x: x[1], reverse=True)

    lines = [
        f"#+title:      Daily review {TODAY.isoformat()}",
        f"#+date:       [{TODAY.isoformat()}]",
        f"#+filetags:   :review:",
        f"#+identifier: {DAILY_ID}",
        "",
        "Generated by pks-daily-review (non-LLM fallback). Same-day re-run",
        "overwrites this note.",
    ]

    lines += render_section(
        "Stale fleeting (>14d)",
        [(n, days_since_denote(n["date"])) for n in stale_fleeting],
        lambda e: f"{e[1]:>3}d  ")

    lines += render_section(
        "Active projects (_agenda)",
        list(projects),
        lambda e: "     ")

    lines += render_section(
        "Stale MOCs (>30d mtime)",
        stale_mocs,
        lambda e: f"{e[1]:>3}d  ")

    lines += render_section(
        "Stale review-queue (>30d mtime)",
        stale_review,
        lambda e: f"{e[1]:>3}d  ")

    lines.append("")

    os.makedirs(os.path.dirname(OUT), exist_ok=True)
    with open(OUT, "w") as f:
        f.write("\n".join(lines))

    print(OUT)


if __name__ == "__main__":
    main()
