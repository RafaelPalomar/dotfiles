#!/usr/bin/env bash
# hermes-pass-sync: refresh ~/.hermes/secrets.env from pass(1).
#
# The home-hermes shepherd service (entelequia/home/machines/curie-
# rafael.scm) sources $HOME/.hermes/secrets.env at gateway start.
# This script regenerates that file from the local pass(1) store so
# secrets are GPG-encrypted at rest and only landed (decrypted) in
# the envfile while the service needs them.
#
# Workflow:
#
#   1. Insert each secret into pass once:
#        $ pass insert hermes/openai-key
#        $ pass insert hermes/anthropic-key
#        ...
#   2. Run this script when you onboard or rotate a key:
#        $ hermes-pass-sync
#   3. Reload the daemon to pick up the new envfile:
#        $ herd restart hermes
#
# Missing entries are silently skipped (so partial onboarding works:
# install just the providers you actually use).  Run with --verbose to
# see which keys were found and which were skipped.
#
# Security:
#   - umask 077 + chmod 600: envfile is owned by you, readable only
#     by your UID.  Shepherd reads it as the same user, so this is
#     sufficient for a single-user workstation.
#   - The envfile lives at $HOME/.hermes/secrets.env — outside the
#     world-readable Guix store.
#   - DO NOT commit this file to git; ~/.hermes/ is per-user state
#     and never tracked by entelequia.
#
# Re-run any time you `pass insert hermes/<thing>`.

set -euo pipefail

verbose=0
case "${1:-}" in
  -v|--verbose) verbose=1 ;;
  -h|--help)
    sed -n '2,/^$/p' "$0" | sed 's/^# \?//'
    exit 0
    ;;
esac

# Pull secrets — keep this list in sync with what the hermes gateway
# actually consults at runtime.  See `hermes doctor` for the live
# provider/channel list.
declare -a SECRETS=(
  # LLM providers
  OPENAI_API_KEY:hermes/openai-key
  ANTHROPIC_API_KEY:hermes/anthropic-key
  OPENROUTER_API_KEY:hermes/openrouter-key
  NOUS_API_KEY:hermes/nous-key
  GOOGLE_API_KEY:hermes/google-key
  # Messaging channels (curie's [messaging] extras)
  TELEGRAM_BOT_TOKEN:hermes/telegram-bot-token
  DISCORD_BOT_TOKEN:hermes/discord-bot-token
  SLACK_BOT_TOKEN:hermes/slack-bot-token
  SLACK_SIGNING_SECRET:hermes/slack-signing-secret
  # Hermes gateway auth (token mode)
  HERMES_GATEWAY_TOKEN:hermes/gateway-token
)

target_dir="$HOME/.hermes"
target_file="$target_dir/secrets.env"
tmp_file="$target_dir/secrets.env.tmp.$$"

umask 077
mkdir -p "$target_dir"
chmod 700 "$target_dir"

found=0
skipped=0

# Write atomically — assemble in tmp file, mv to target only on success
# so the daemon never sees a half-written envfile.
{
  echo "# Generated by hermes-pass-sync $(date -Iseconds)"
  echo "# Source: $HOME/.password-store/hermes/*"
  echo "# Do not edit by hand; rerun hermes-pass-sync to refresh."
  for entry in "${SECRETS[@]}"; do
    env_name="${entry%%:*}"
    pass_path="${entry#*:}"
    if value=$(pass show "$pass_path" 2>/dev/null) && [ -n "$value" ]; then
      printf '%s=%s\n' "$env_name" "$value"
      found=$((found + 1))
      [ "$verbose" -eq 1 ] && echo "  + $env_name (from $pass_path)" >&2
    else
      skipped=$((skipped + 1))
      [ "$verbose" -eq 1 ] && echo "  - $env_name (no $pass_path)" >&2
    fi
  done
} > "$tmp_file"

mv "$tmp_file" "$target_file"
chmod 600 "$target_file"

echo "hermes-pass-sync: wrote $target_file ($found keys, $skipped missing)" >&2
if [ "$found" -eq 0 ]; then
  echo "warning: no secrets found.  Did you 'pass insert hermes/<name>' yet?" >&2
fi
if pgrep -u "$(id -u)" -f 'hermes.*gateway' >/dev/null 2>&1; then
  echo "note: gateway is running — herd restart hermes  to pick up changes." >&2
fi
