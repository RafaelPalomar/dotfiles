#!/usr/bin/env python3
"""SessionStart hook: brief PKS state summary as additionalContext.

Reads section counts from today's pks-daily-review note (regenerating
it if absent).

Must fail closed — if anything goes wrong, emit empty additionalContext
rather than blocking session start.
"""
import datetime
import json
import os
import re
import subprocess
import sys

PKS = os.path.expanduser("~/pks")
TODAY = datetime.date.today()
DAILY_FILE = os.path.join(
    PKS, "fleeting",
    TODAY.strftime("%Y%m%dT080000") + "--daily-review__review.org")

SECTION_RE = re.compile(r'^\* (.+?)\s+—\s*total:\s*(\d+)')


def emit(ctx):
    print(json.dumps({
        "hookSpecificOutput": {
            "hookEventName": "SessionStart",
            "additionalContext": ctx,
        }
    }))


def regenerate_daily():
    try:
        subprocess.check_call(
            ["pks-daily-review"],
            timeout=5,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL)
        return True
    except Exception:
        return False


def parse_sections(path):
    """Parse the daily-review file's section headers.
    Returns a dict: section_name -> total count.
    """
    sections = {}
    try:
        with open(path) as f:
            for line in f:
                m = SECTION_RE.match(line)
                if m:
                    sections[m.group(1).strip()] = int(m.group(2))
    except OSError:
        pass
    return sections


try:
    if not os.path.exists(DAILY_FILE):
        regenerate_daily()

    s = parse_sections(DAILY_FILE)
    proj = s.get("Active projects (_agenda)", 0)
    fleet = s.get("Stale fleeting (>14d)", 0)
    mocs = s.get("Stale MOCs (>30d mtime)", 0)
    rq = s.get("Stale review-queue (>30d mtime)", 0)

    ctx = (f"PKS state: {proj} active _agenda projects · "
           f"{fleet} stale fleeting (>14d) · "
           f"{mocs} stale MOCs (>30d) · "
           f"{rq} review-queue items >30d. "
           f"`C-c n D` in Emacs for full digest.")
    emit(ctx)
except Exception:
    emit("")
    sys.exit(0)
